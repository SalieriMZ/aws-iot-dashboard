# =========================================================
# AWS IoT Telemetry Dashboard — Environment Variables
# Copy this file to .env and fill in your values
# =========================================================

# Mode: "local" (embedded Aedes broker) or "aws" (AWS IoT Core)
IOT_MODE=local

# MQTT broker port (only used in LOCAL mode)
MQTT_PORT=1883

# WebSocket server port (used in both modes)
WS_PORT=4000

# ---- AWS IoT Core settings (only used when IOT_MODE=aws) ----

# Your AWS IoT Core endpoint (from: aws iot describe-endpoint --endpoint-type iot:Data-ATS)
# Example: abc123def456gh-ats.iot.us-east-1.amazonaws.com
AWS_IOT_ENDPOINT=

# Path to the directory containing your AWS IoT certificates
# Default: ./certs (relative to project root)
CERTS_DIR=./certs
